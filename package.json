{
  "name": "finsight-marketing-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "node scripts/prepare-db.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@prisma/client": "6.19.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "lucide-react": "1.58.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
